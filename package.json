{
  "name": "vscode-powerkit",
  "displayName": "PowerKit",
  "description": "A collection of practical tools for VS Code",
  "version": "0.0.4",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-powerkit",
          "title": "PowerKit",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "vscode-powerkit": [
        {
          "id": "vscode-powerkit.features",
          "name": "Features",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-powerkit.openNetwork",
        "title": "Open Network",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openGenerators",
        "title": "Open Generators",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openCrypto",
        "title": "Open Crypto",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openNotebook",
        "title": "Open Notebook",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.newNote",
        "title": "New Note",
        "category": "PowerKit",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-powerkit.newNote",
          "when": "vscode-powerkit.notebookActive",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "rimraf out && tsc -p ./",
    "compile:webview": "tsc -p webview/tsconfig.json && vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/vsce": "^3.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
