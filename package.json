{
  "name": "vscode-powerkit",
  "displayName": "PowerKit",
  "description": "Developer utilities for VS Code",
  "version": "0.4.7",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugAdapterProtocolTracker",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-powerkit",
          "title": "PowerKit",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "vscode-powerkit": [
        {
          "id": "vscode-powerkit.features",
          "name": "PowerKit",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-powerkit.openLaunchd",
        "title": "Open LaunchAgents",
        "category": "PowerKit",
        "enablement": "isMac"
      },
      {
        "command": "vscode-powerkit.generateGitignore",
        "title": "Generate .gitignore",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runScript",
        "title": "Run Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.debugScript",
        "title": "Debug Script",
        "icon": "$(debug)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runNpmScript",
        "title": "Run npm Script",
        "icon": "$(terminal)",
        "category": "PowerKit"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vscode-powerkit.runScript",
          "when": "resourceLangId == javascript || resourceLangId == typescript || resourceLangId == csharp || resourceExtname == .sh && !isWindows || resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.debugScript",
          "when": "resourceLangId == javascript || resourceLangId == typescript",
          "group": "navigation@11"
        },
        {
          "command": "vscode-powerkit.runNpmScript",
          "when": "explorerResourceIsFolder && resourcePath in vscode-powerkit.npmScriptFolders",
          "group": "navigation@12"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-powerkit.runNpmScript",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "rimraf out && tsc -p ./",
    "compile:webview": "tsc -p webview/tsconfig.json && vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/vsce": "^3.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@vscode/debugprotocol": "^1.68.0"
  }
}
