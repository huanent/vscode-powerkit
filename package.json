{
  "name": "vscode-powerkit",
  "displayName": "PowerKit",
  "description": "Developer utilities for VS Code",
  "version": "0.8.1",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugAdapterProtocolTracker",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscode-powerkit.chatEditor",
        "displayName": "Chat",
        "selector": [
          {
            "filenamePattern": "*.chat"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vscode-powerkit.explorerEditor",
        "displayName": "Explorer",
        "selector": [
          {
            "filenamePattern": "*.explorer"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "configuration": "./resources/http/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./resources/http/http.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-powerkit",
          "title": "PowerKit",
          "icon": "$(tools)"
        }
      ],
      "panel": [
        {
          "id": "vscode-powerkit-result",
          "title": "Result",
          "icon": "$(output)"
        }
      ]
    },
    "views": {
      "vscode-powerkit": [
        {
          "id": "vscode-powerkit.features",
          "name": "PowerKit",
          "icon": "$(list-tree)"
        }
      ],
      "vscode-powerkit-result": [
        {
          "id": "vscode-powerkit.httpResult",
          "name": "Result",
          "type": "webview",
          "icon": "$(output)",
          "when": "vscode-powerkit.httpResultVisible"
        }
      ]
    },
    "submenus": [
      {
        "id": "vscode-powerkit.sourceControl",
        "label": "Source Control"
      }
    ],
    "commands": [
      {
        "command": "vscode-powerkit.openHttpClient",
        "title": "Open HTTP Client",
        "icon": "$(globe)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.newHttpClient",
        "title": "New HTTP Request",
        "icon": "$(new-file)",
        "category": "PowerKit",
        "enablement": "vscode-powerkit.httpEditor"
      },
      {
        "command": "vscode-powerkit.renameHttpFile",
        "title": "Rename HTTP Request",
        "icon": "$(edit)",
        "category": "PowerKit",
        "enablement": "vscode-powerkit.httpEditor"
      },
      {
        "command": "vscode-powerkit.deleteHttpFile",
        "title": "Delete HTTP Request",
        "icon": "$(trash)",
        "category": "PowerKit",
        "enablement": "vscode-powerkit.httpEditor"
      },
      {
        "command": "vscode-powerkit.openLaunchd",
        "title": "Open LaunchAgents",
        "category": "PowerKit",
        "enablement": "isMac"
      },
      {
        "command": "vscode-powerkit.generateGitignore",
        "title": "Generate .gitignore",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.sendHttpRequest",
        "title": "Send HTTP Request",
        "icon": "$(play)",
        "category": "PowerKit",
        "enablement": "editorLangId == http && isWorkspaceTrusted"
      },
      {
        "command": "vscode-powerkit.runDotnetScript",
        "title": "Run dotnet Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runShScript",
        "title": "Run sh Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runBatScript",
        "title": "Run bat Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runNodeScript",
        "title": "Run node Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runBunScript",
        "title": "Run bun Script",
        "icon": "$(play)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runNpmScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.runBunPackageScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.pullGitRepository",
        "title": "Pull",
        "icon": "$(cloud-download)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.pushGitRepository",
        "title": "Push",
        "icon": "$(cloud-upload)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.fetchGitRepository",
        "title": "Fetch",
        "icon": "$(sync)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.checkoutGitRepository",
        "title": "Checkout to...",
        "icon": "$(git-branch)",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openChat",
        "title": "Open Chat",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.newChat",
        "title": "New Chat",
        "category": "PowerKit",
        "icon": "$(add)"
      },
      {
        "command": "vscode-powerkit.newChatTab",
        "title": "New Chat Tab",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openExplorer",
        "title": "Open in Explorer",
        "category": "PowerKit"
      },
      {
        "command": "vscode-powerkit.openExplorerTab",
        "title": "Open Explorer Tab",
        "category": "PowerKit"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscode-powerkit.newHttpClient",
          "when": "vscode-powerkit.httpEditor",
          "group": "navigation@9"
        },
        {
          "command": "vscode-powerkit.renameHttpFile",
          "when": "vscode-powerkit.httpEditor",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.deleteHttpFile",
          "when": "vscode-powerkit.httpEditor",
          "group": "navigation@11"
        },
        {
          "command": "vscode-powerkit.newChat",
          "when": "activeCustomEditorId == vscode-powerkit.chatEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "vscode-powerkit.sourceControl",
          "when": "explorerResourceIsFolder && resourcePath in vscode-powerkit.gitRepositoryFolders",
          "group": "navigation@9"
        },
        {
          "command": "vscode-powerkit.runDotnetScript",
          "when": "resourceExtname == .cs",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.runShScript",
          "when": "resourceExtname == .sh && !isWindows",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.runBatScript",
          "when": "resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.runNodeScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && vscode-powerkit.nodeAvailable && !vscode-powerkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.runBunScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && vscode-powerkit.bunAvailable && vscode-powerkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "vscode-powerkit.runNpmScript",
          "when": "explorerResourceIsFolder && vscode-powerkit.npmAvailable && resourcePath in vscode-powerkit.npmScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "vscode-powerkit.runBunPackageScript",
          "when": "explorerResourceIsFolder && vscode-powerkit.bunAvailable && resourcePath in vscode-powerkit.bunScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "vscode-powerkit.openExplorer",
          "group": "navigation@999"
        }
      ],
      "vscode-powerkit.sourceControl": [
        {
          "command": "vscode-powerkit.pullGitRepository",
          "group": "1_remote@1"
        },
        {
          "command": "vscode-powerkit.pushGitRepository",
          "group": "1_remote@2"
        },
        {
          "command": "vscode-powerkit.fetchGitRepository",
          "group": "1_remote@3"
        },
        {
          "command": "vscode-powerkit.checkoutGitRepository",
          "group": "2_local@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-powerkit.newHttpClient",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.renameHttpFile",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.deleteHttpFile",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.runNodeScript",
          "when": "vscode-powerkit.nodeAvailable && !vscode-powerkit.bunWorkspace"
        },
        {
          "command": "vscode-powerkit.runBunScript",
          "when": "vscode-powerkit.bunAvailable && vscode-powerkit.bunWorkspace"
        },
        {
          "command": "vscode-powerkit.runNpmScript",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.runBunPackageScript",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.pullGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.pushGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.fetchGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-powerkit.checkoutGitRepository",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-powerkit.openChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "!vscode-powerkit.chatWebviewFocus"
      },
      {
        "command": "vscode-powerkit.newChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "activeCustomEditorId == vscode-powerkit.chatEditor && vscode-powerkit.chatWebviewFocus"
      },
      {
        "command": "vscode-powerkit.newChatTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == vscode-powerkit.chatEditor && vscode-powerkit.chatWebviewFocus"
      },
      {
        "command": "vscode-powerkit.openExplorer",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "vscode-powerkit.openExplorerTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == vscode-powerkit.explorerEditor && vscode-powerkit.explorerWebviewFocus"
      }
    ],
    "configuration": {
      "title": "PowerKit",
      "properties": {
        "powerkit.storagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "PowerKit data directory. Supports `~`. Defaults to extension global storage.",
          "scope": "machine"
        },
        "powerkit.chat.prompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "The prompt used for chats.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "rimraf out && tsc -p ./",
    "compile:webview": "tsc -p webview/tsconfig.json && vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.x",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vscode/vsce": "^3.6.2",
    "dompurify": "^3.4.13",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.0",
    "markdown-it-texmath": "^1.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/debugprotocol": "^1.68.0",
    "exceljs": "^4.4.0",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
